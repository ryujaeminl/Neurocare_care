# 환자 앱(../Neurocare)과 같은 값을 써야 DB/세션/임베딩이 공유된다.

# Upstage Solar (https://console.upstage.ai/api-keys) - 기억(Memory) 임베딩 생성에 사용 (필수)
UPSTAGE_API_KEY=

# NextAuth(Auth.js) 세션 서명 키 — 환자 앱과 동일한 값이어야 한다 (필수)
AUTH_SECRET=

# Pinecone (https://app.pinecone.io) — 가족 기억 임베딩 저장용. 비워두면 DB 저장만 되고
# 환자 앱 대화 중 RAG 검색 대상에서는 빠진다.
PINECONE_API_KEY=
PINECONE_INDEX=neurocare

# Turso(hosted SQLite) - 환자 앱과 동일한 DB. 비워두면 .env의 DATABASE_URL(로컬 파일)로 폴백한다.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# 이 앱은 보호자 전용이다 - 환자 계정으로 가입/로그인하면 이 주소로 돌려보낸다.
NEXT_PUBLIC_PATIENT_APP_URL=http://localhost:3000
